# Generate with: openssl rand -hex 32. Used for dashboard login and automation Bearer auth.
STUDIO_TOKEN=
APP_ORIGIN=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379
DATA_DIR=./data
# Hermes Agent's OpenAI-compatible API. Use a dedicated restricted profile.
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
RENDER_CONCURRENCY=4
# Docker supplies this path; leave blank for Remotion-managed Chrome outside Docker.
CHROME_PATH=
# Explicitly allows an offline sample video; real URL jobs always require providers.
DEMO_ENABLED=true
